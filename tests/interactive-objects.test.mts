import test from 'node:test';import assert from 'node:assert/strict';import * as T from 'three';import {buildStickerGeometry} from '../src/lib/sticker-geometry.ts';import {createClothMotion} from '../src/lib/cloth-motion.ts';
test('sticker is a thin solid with a printable front rather than a rotating image',()=>{const g=buildStickerGeometry();g.sheet.computeBoundingBox();const b=g.sheet.boundingBox!;assert.ok(b.max.z-b.min.z>.001);assert.ok(b.max.z-b.min.z<.004);const front=g.print.getAttribute('position');for(let i=0;i<front.count;i++)assert.ok(front.getZ(i)>b.max.z);assert.ok(g.sheet.getAttribute('normal'));g.sheet.dispose();g.print.dispose();});
test('fleece dissipates an impulse faster and both materials settle exactly',()=>{const samples=[];for(const fabric of ['cotton','fleece'] as const){const motion=createClothMotion({top:1.5,bottom:.76,collision:false,fabric});const p=new T.Vector3(.12,.8,.1),out=new T.Vector3(),n=new T.Vector3(0,0,1);motion.kick(.5,.3);let total=0;for(let i=0;i<120;i++){motion.step(1/60);motion.deform(p,n,out);total+=out.distanceTo(p);}samples.push(total);for(let i=0;i<900;i++)motion.step(1/60);assert.equal(motion.active(),false);motion.deform(p,n,out);assert.deepEqual(out.toArray(),p.toArray());}assert.ok(samples[1]<samples[0]);});
